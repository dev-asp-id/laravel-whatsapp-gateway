{
    "name": "devaspid/laravel-whatsapp-gateway",
    "description": "Laravel package for WhatsApp Gateway API (wa-api-by-asp / https://wa-gateway.asp.web.id). Supports text messages, media, device management, and Laravel Notification Channel.",
    "keywords": [
        "laravel",
        "whatsapp",
        "whatsapp-gateway",
        "wa-gateway",
        "sdk",
        "notification",
        "devaspid"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "devaspid",
            "email": "dev@asp.web.id",
            "homepage": "https://github.com/devaspid"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "mockery/mockery": "^1.6|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Devaspid\\WhatsappGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devaspid\\WhatsappGateway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devaspid\\WhatsappGateway\\WhatsappServiceProvider"
            ],
            "aliases": {
                "Whatsapp": "Devaspid\\WhatsappGateway\\Facades\\Whatsapp"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
